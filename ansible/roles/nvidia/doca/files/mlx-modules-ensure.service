[Unit]
Description=Load the Mellanox module stack when openibd left devices unbound
Documentation=file:/usr/local/sbin/mlx-modules-ensure.sh
# openibd unloads the OFED stack before loading it and aborts when sunrpc is
# still pinned, leaving Mellanox VFs with no driver. Ordered after it (with no
# dependency, so this runs whether it succeeded or failed) and before kubelet,
# so the node always presents its NICs to workloads.
#
# openibd itself runs far earlier (DefaultDependencies=false, WantedBy=
# sysinit.target, Before=network.target remote-fs-pre.target). This unit keeps
# default dependencies and so starts after basic.target -- late enough that an
# fstab or .mount unit ordered on remote-fs.target would already have failed.
# That suits KaaS, whose Lustre mount runs from PostKubeadmCommands after
# kubelet; a node mounting a fabric filesystem from fstab would need this
# ordered as early as openibd instead.
After=openibd.service
Before=kubelet.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/mlx-modules-ensure.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
